generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  id        String       @id @default(uuid())
  username  String       @unique(map: "User_username_key")
  email     String       @unique(map: "User_email_key")
  password  String
  gender    user_gender?
  createdAt DateTime     @default(now())
  updatedAt DateTime?
  nomor     String?
  role      user_role?
  bookings  booking[]
}

model booking {
  id                  String         @id @default(uuid())
  userId              String
  lapanganId          String
  tanggalBooking      DateTime?      @db.Date
  totalharga          Int?
  status              statusBooking? @default(PENDING)
  createdAt           DateTime?      @default(now())
  updatedAt           DateTime?
  tersedia            Boolean        @default(true)
  isLookingForPartner Boolean        @default(false)
  slotWaktuId         String
  detailLapangan      detailLapangan @relation(fields: [lapanganId], references: [id])
  slotWaktu           slotwaktu      @relation(fields: [slotWaktuId], references: [id])
  user                user           @relation(fields: [userId], references: [id])

  @@index([lapanganId], map: "booking_lapanganId_fkey")
  @@index([slotWaktuId], map: "booking_slotWaktuId_fkey")
  @@index([userId], map: "booking_userId_fkey")
}

model detailLapangan {
  id           String    @id @default(uuid())
  nama         String
  alamat       String
  harga        Int
  tipeLapangan String
  linkGambar   String
  noTelp       String
  deskripsi    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime?
  bookings     booking[]
}

model slotwaktu {
  id         String    @id
  jamMulai   DateTime? @db.Time(3)
  jamSelesai DateTime? @db.Time(3)
  createdAt  DateTime? @default(now())
  updatedAt  DateTime?
  bookings   booking[]
}

enum statusBooking {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
}

enum user_gender {
  Pria
  Wanita
}

enum user_role {
  Admin
  User
}
